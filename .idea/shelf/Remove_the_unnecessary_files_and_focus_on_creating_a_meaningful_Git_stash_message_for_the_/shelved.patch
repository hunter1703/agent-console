-  96: 384,   // 384px
-} as const
-
-// ============================================================================
-// SEMANTIC SPACING
-// ============================================================================
-
-/**
- * Semantic spacing names for common use cases.
- * These map to Tailwind spacing classes for consistency.
- */
-export const SPACING = {
