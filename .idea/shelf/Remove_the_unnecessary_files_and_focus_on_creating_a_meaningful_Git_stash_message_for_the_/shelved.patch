-
-export interface ButtonProps extends ButtonHTMLAttributes<HTMLButtonElement> {
-  variant?: 'primary' | 'secondary' | 'ghost' | 'danger'
-  size?: 'sm' | 'md' | 'lg'
-  loading?: boolean
-  icon?: ReactNode
-  iconPosition?: 'left' | 'right'
-  magnetic?: boolean
-  liquidBorder?: boolean // Enable liquid SVG border morphing
-  children: ReactNode
-}
