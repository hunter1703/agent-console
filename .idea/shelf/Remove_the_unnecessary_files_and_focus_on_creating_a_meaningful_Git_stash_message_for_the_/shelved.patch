-  enabled?: boolean
-  
-  /**
-   * Whether to preload the sound
-   * @default false
-   */
-  preload?: boolean
-}
-
-const SOUND_PATHS: Record<SoundName, string> = {
-  click: '/sounds/click.mp3',
-  hover: '/sounds/hover.mp3',
-  success: '/sounds/success.mp3',
-  error: '/sounds/error.mp3',
-  notification: '/sounds/notification.mp3',
