-
-import { motion } from 'framer-motion'
-import { ReactNode } from 'react'
-import { springPresets } from '@/lib/constants/animations'
-
-export interface StaggerListProps {
-  children: ReactNode[]
-  stagger?: number // Delay between items (seconds)
